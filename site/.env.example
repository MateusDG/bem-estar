# Copy to .env.local for local testing. On Hostinger use hPanel environment variables.
# Configure secrets in the hosting panel; never put them in source or NEXT_PUBLIC_*.
STRIPE_SECRET_KEY=
CHECKOUT_ENABLED=false
SITE_URL=
# Set true before the production build when the store is ready for search engines.
SITE_INDEXABLE=false
DELIVERY_MAX_DAYS=10
# No earliest arrival date has been promised.
DELIVERY_MIN_DAYS=
# Optional configuration fields; use only real merchant information.
STORE_COMPANY_NAME=
STORE_CNPJ=
STORE_ADDRESS=
STORE_EMAIL=
STORE_PHONE=
